# Enterprise Policy Hybrid RAG Configuration

# LLM Provider Configuration ("openai", "gemini", "anthropic", "ollama", "mock")
LLM_PROVIDER=mock
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0

# API Keys (Optional when using mock / local mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding & Reranker Settings
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
EMBEDDING_DIMENSION=1024
USE_MOCK_MODELS=true

# Vector Database
VECTOR_DB_TYPE=chroma
CHROMA_COLLECTION_NAME=enterprise_policies
QDRANT_URL=

# Retrieval Tuning
BM25_TOP_K=20
VECTOR_TOP_K=20
RRF_CONSTANT=60
BM25_WEIGHT=0.50
VECTOR_WEIGHT=0.50
CANDIDATE_POOL=40
FINAL_RERANKED_CHUNKS=6
FINAL_TOP_K=5

# Section-Based Chunking
TARGET_CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
PRESERVE_COMPLETE_SECTIONS=true

# Multi-Query Expansion
ENABLE_MULTI_QUERY=true
NUM_EXPANDED_QUERIES=3

